# Copy to `.env` and adjust. Every value is optional (defaults shown).

# Host port for the web application.
BEE_WEB_PORT=7777

# Port the backend API listens on (inside the Compose network; nginx proxies /api to it).
BEE_API_PORT=8000

# MySQL credentials (use URL-safe characters: they are embedded in the connection URL).
MYSQL_DATABASE=beetv
MYSQL_USER=beetv
MYSQL_PASSWORD=beetv
MYSQL_ROOT_PASSWORD=beetv-root

# Bee Review AI. Without a token Bee Review runs on its offline rule-based engine.
# Create a free token at https://huggingface.co/settings/tokens ("Make calls to Inference Providers").
HF_TOKEN=
BEE_INSIGHT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Any OpenAI-compatible endpoint works (OpenAI, Groq, Together, Ollama, vLLM...).
BEE_INSIGHT_API_BASE_URL=https://router.huggingface.co/v1

BEE_LOG_LEVEL=INFO
